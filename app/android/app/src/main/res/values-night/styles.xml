<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Identical to `values/styles.xml`, and deliberately so: the splash is
         black in both modes (D323). The file stays rather than being deleted
         because the platform still needs *a* night answer, and the stock one it
         would fall back to is not this one. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
