<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- **Declared on purpose, and this line is the whole of D376.**

         From D93 until ticket 050 this read `tools:node="remove"`, which
         stripped INTERNET from the merged manifest and made offline play a
         thing Android enforced rather than a thing the code promised. Play
         Games Services cannot work without the permission, and Android grants
         it to an application rather than to a screen, so there is no version of
         a leaderboard that keeps the old guarantee.

         **What did not change: spec F13 and S1.** Both are scoped to a game
         against a computer opponent, and both are still true - the rating is
         submitted after a game is scored, never during one, and the engine
         still has no network dependency and declares no runtime dependencies at
         all. They drop from enforced to reviewed on Android, which is the
         status they have carried on iOS since S20 and D306.

         **Why this is an explicit declaration rather than a deletion.** The
         directive that used to be here is what caught D356: Play Billing pulls
         in com.google.android.datatransport:transport-backend-cct, a telemetry
         transport that declares INTERNET, and a bundle shipped with it while
         the old source-manifest check passed. Deleting the line entirely would
         let the next such library arrive in silence. Declaring the permission
         here means check.sh can assert it is present *deliberately*, and a diff
         that adds a second network-using dependency still has to say so.

         ACCESS_NETWORK_STATE is still left to the libraries that ask for it. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="Quadrim"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- So a browser can be found for the privacy policy, the EULA and the
             support page (D384). Android 11 hides other packages by default,
             and without this url_launcher reports that nothing can open an
             https address - a link that silently does nothing, which is
             precisely the "functional link" the rejection asked for.

             It grants no network access of its own: the intent hands the
             address to whichever app already owns browsing. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
