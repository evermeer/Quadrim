# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Dart / Flutter (per-package .gitignore files cover the rest)
.dart_tool/
build/

# Local tooling state
.claude/settings.local.json
.vs/
.gstack/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Written by flutter gen-l10n and read by tool/check.sh. Regenerated on every
# run, so committing it would only ever preserve a stale answer.
app/untranslated.json

# Shareable build artefacts. Never committed: a 47 MB binary per build would
# dwarf the repository, and it is reproducible from a tag.
dist/
__pycache__/

# Store icons, generated by tools/storegen/storegen.py --icons.
#
# **Ignored, unlike every other generator's output in this repo.** linegen,
# bookgen and artgen all commit what they produce, because a build consumes it.
# These 45 files are consumed by a person clicking Upload in a web console, are
# derived in seconds from doc/designs/ by a committed script, and are 20 MB of
# binary that would churn on every regeneration.
doc/store/icons/

